# Copy this file to .env, then replace the placeholders.
# NEVER commit .env or paste API keys into Google Classroom.

GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE

# Use model IDs currently available in your provider accounts.
GEMINI_MODEL=PASTE_GROQ_MODEL_ID_HERE
GROQ_MODEL=PASTE_GROQ_MODEL_ID_HERE


# Prices in USD per 1,000,000 tokens.
# Check each provider's official pricing page for your selected model.
GEMINI_INPUT_PRICE_PER_M=0
GEMINI_OUTPUT_PRICE_PER_M=0
GROQ_INPUT_PRICE_PER_M=0
GROQ_OUTPUT_PRICE_PER_M=0
